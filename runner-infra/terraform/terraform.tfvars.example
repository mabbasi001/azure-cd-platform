subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "northeurope"

# Your SSH public key (contents of e.g. ~/.ssh/id_ed25519.pub).
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Restrict SSH to your current IP, e.g. "203.0.113.5/32". Leave unset to
# create no inbound SSH rule (runner only needs outbound to GitHub).
# admin_ssh_cidr = "203.0.113.5/32"
